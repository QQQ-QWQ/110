# ============================================================
# 环境变量样例 —— 复制为 .env 后按需修改
#   cp .env.example .env
# 全部变量都有默认值，不配置也能正常启动。
# ============================================================

# ---------- 对外访问 ----------
# Web 入口端口（浏览器访问 http://localhost:<WEB_PORT>）
WEB_PORT=8080

# ---------- 数据库 ----------
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=demand_acceptance

# ---------- 预置测试账号 ----------
# 三个演示账号（alice / bob / carol）的初始密码，仅首次初始化时使用
SEED_PASSWORD=Passw0rd!

# ---------- 数据库连接池与语句超时 ----------
# Prisma 的默认值在这里**不够安全**，故显式声明：
#   · connection_limit：默认 = 物理 CPU 核数 * 2 + 1。容器可见的核数受宿主与
#     cgroup 限制影响，默认值不可预期，显式给出便于跨环境一致。
#   · pool_timeout：等待空闲连接的上限（秒）。超时即报错，而不是无限排队。
#   · statement_timeout：**Prisma 默认 0，即不限**。这意味着一条病态查询
#     （例如未来某个漏加索引的模糊搜索）可以无限期占用连接；池一旦耗尽，
#     所有请求一起排队，故障会从「一个接口慢」放大成「全站不可用」。
#     10s 是「先宽松、再收紧」的取值 —— 需结合真实数据量观测后调整，
#     过短会误杀正常的慢查询（例如首次大范围列表查询）。
# 说明：connection_limit / pool_timeout 由 Prisma 直接识别；
#       statement_timeout 通过 libpq 的 options 参数下发（见 docker-compose.yml）。
# 已实测：设 10000 后 `SHOW statement_timeout` 由 `0` 变为 `10s`。
DB_CONNECTION_LIMIT=10
DB_POOL_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=10000

# ---------- 数据保留清理（定时任务） ----------
# 幂等记录与会话两张表若无清理会无界增长。清理规则见 backend/src/domain/retention.ts：
#   · 幂等记录：只删 status=COMPLETED 且 createdAt 超过 24h 的行；
#     **PROCESSING 一律不删** —— 那是「请求正在进行中」的占坑标记，
#     删掉会让同一幂等键被重复占坑，幂等保证直接失效。滞留的 PROCESSING
#     只写告警日志（通常意味着有请求异常中断）。
#   · 会话：只删已过绝对过期时间（expiresAt）的行。
# 多副本同时运行是安全的：deleteMany 天然幂等，无需分布式锁。
MAINTENANCE_ENABLED=true
MAINTENANCE_INTERVAL_MS=3600000
MAINTENANCE_STARTUP_DELAY_MS=5000

# ---------- 可观测性（请求编号与访问日志） ----------
# 每次请求都会带一个 X-Request-Id：客户端/网关传来的合法值会被沿用，否则新生成。
# 响应头始终回传该编号，5xx 的响应体里也会带上它 —— 用户报障时给出编号，
# 就能在日志里精确定位那一次请求。实现见 backend/src/core/request-id.ts。
#
# 合法形态有限制（可见 ASCII 标识符子集，≤128 字符）：编号会被写进日志行，
# 不加限制就等于开放了「换行符伪造日志条目」与「超长串撑爆日志」两个口子。
#
# 访问日志默认开启（一行一次请求，含方法/路径/状态码/耗时/编号）。
# 压测时设为 false 可关掉，避免日志本身成为瓶颈。
ACCESS_LOG=true

# ---------- 登录并发闸门（报告 §5.1 E4） ----------
# 为什么需要：密码校验用 bcryptjs（纯 JS 实现，Dockerfile 为规避原生模块编译
# 而刻意选择），cost=10 时单次数十至上百毫秒且**在 Node 单线程上烧 CPU**。
# 并发登录会争抢同一个事件循环，把所有接口一起拖慢。闸门把故障域从
# 「全站变慢」收窄为「登录排队或快速失败」。
#
# 闸门只罩住**密码校验**那一段：数据库查询是便宜 I/O 且有连接池兜底，
# 多罩一层只会降低吞吐而不额外保护什么。
#
# 三项都不建议随便调大：
#   · LOGIN_CONCURRENCY：默认取 os.availableParallelism()（容器内会考虑 cgroup
#     配额，不像 os.cpus() 那样返回宿主机核数）。再大也不会更快 —— 只有
#     一个 JS 线程在算，只会加剧排队。
#   · LOGIN_QUEUE_LIMIT：排队必须有上限，否则只是把问题从 CPU 挪到内存。
#     队列满 → 立即 503（带 Retry-After），快速失败比「排很久再超时」友好。
#   · LOGIN_ACQUIRE_TIMEOUT_MS：排队等待上限；0 表示不设超时。
# 配置值非法时**启动即失败**，而不是悄悄退回默认值（静默回退会让人以为闸门开着）。
# LOGIN_CONCURRENCY=4
# LOGIN_QUEUE_LIMIT=50
# LOGIN_ACQUIRE_TIMEOUT_MS=5000

# ---------- 会话 Cookie ----------
# 内网 http 部署保持 false；启用 HTTPS 后必须改为 true
COOKIE_SECURE=false

# ---------- 前端开发期（可选） ----------
# npm run dev 时 /api 的代理目标
# VITE_API_TARGET=http://127.0.0.1:3000
